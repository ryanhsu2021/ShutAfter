<Window x:Class="ShutAfter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ShutAfter.Ui"
        Title="ShutAfter" Width="512" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0B0C10" Foreground="#EDEFF5"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        设计语言：工业仪表盘。
        石墨黑底 + 单一点缀色（电子蓝），所有数值用 DIN 风格等宽数字，
        分区一律「小标签 + 细线 + 右侧元信息」，一屏只有一个主操作。
    -->

    <Window.Resources>

        <!-- ===== 色板：底 60 / 面板 30 / 强调 10 ===== -->
        <SolidColorBrush x:Key="Bg" Color="#0B0C10"/>
        <SolidColorBrush x:Key="Surface" Color="#11131A"/>
        <SolidColorBrush x:Key="Inset" Color="#0C0E14"/>
        <SolidColorBrush x:Key="Line" Color="#20232E"/>
        <SolidColorBrush x:Key="LineSoft" Color="#191C25"/>
        <SolidColorBrush x:Key="Text" Color="#EDEFF5"/>
        <SolidColorBrush x:Key="Text2" Color="#9BA1B4"/>
        <SolidColorBrush x:Key="Text3" Color="#7B8398"/>
        <SolidColorBrush x:Key="Accent" Color="#3D7DFF"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#16233D"/>
        <SolidColorBrush x:Key="AccentLine" Color="#2B4C86"/>
        <SolidColorBrush x:Key="AccentText" Color="#CBDCFF"/>

        <FontFamily x:Key="Mono">Bahnschrift, Consolas, Microsoft YaHei UI</FontFamily>

        <!-- ===== 滚动条 ===== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Width="5" HorizontalAlignment="Center">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#333849"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 分区标题：标签 + 延伸细线 ===== -->
        <Style x:Key="SecLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== 分段控件 ===== -->
        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="7" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1" Padding="0,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#171A24"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentLine}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentLine}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 主按钮 ===== -->
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" Background="{StaticResource Accent}"
                                BorderBrush="#5A93FF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4E8BFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2F6BE0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#BBD3FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 次按钮 ===== -->
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" Background="#161922"
                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D2130"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2C3142"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentLine}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 文字链按钮（刷新） ===== -->
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="5" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1" Padding="7,3">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#191C26"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 标题栏按钮 ===== -->
        <Style x:Key="Caption" TargetType="Button">
            <Setter Property="Foreground" Value="#8A90A2"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Width="34" Height="28" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D2130"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionDanger" TargetType="Button" BasedOn="{StaticResource Caption}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Width="34" Height="28" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3B1D22"/>
                                <Setter Property="Foreground" Value="#FFB4AE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 输入框 ===== -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Inset}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentLine}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2C3142"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentLine}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NumInput" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Width" Value="62"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- ===== 复选框 ===== -->
        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="bd" Width="16" Height="16" CornerRadius="4"
                                    Background="{StaticResource Inset}" BorderBrush="#333849" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="tick" Data="M 3,7.6 L 6.2,10.8 L 12.4,4.4" Stroke="#FFFFFF"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#45506B"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 开关 ===== -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="track" Width="34" Height="19" CornerRadius="10"
                                    Background="{StaticResource Inset}" BorderBrush="#333849" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="knob" Width="13" Height="13" Fill="#7C8497"
                                         HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="BorderBrush" Value="#45506B"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="knob" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,2,0"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 折叠条 ===== -->
        <Style x:Key="Disclosure" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="9" Background="#0F1118"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="chev" Data="M 0,0 L 4.5,4.5 L 9,0"
                                      Stroke="{StaticResource Text3}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" Margin="1,1,10,0">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0" CenterX="4.5" CenterY="2.5"/>
                                    </Path.RenderTransform>
                                </Path>
                                <TextBlock Grid.Column="1" Text="高级设置" FontSize="12.5"
                                           Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding Tag}" FontSize="11"
                                           Foreground="{StaticResource Text3}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                           Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2C3142"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chev" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" CenterX="4.5" CenterY="2.5"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="Background" Value="#12151E"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2C3142"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Bg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= 标题栏 ================= -->
            <Grid Grid.Row="0" Background="{StaticResource Surface}">
                <Rectangle Height="1" Fill="{StaticResource Line}" VerticalAlignment="Bottom"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                            Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                    <Image x:Name="BrandIcon" Width="17" Height="17" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="ShutAfter" FontFamily="{StaticResource Mono}" FontSize="13"
                               FontWeight="SemiBold" Foreground="{StaticResource Text}"
                               Margin="9,0,0,0" VerticalAlignment="Center"/>
                    <Border Width="1" Height="11" Background="{StaticResource Line}" Margin="11,0,11,0"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="下载完成自动关机" FontSize="11.5" Foreground="{StaticResource Text3}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button x:Name="MinBtn" Content="&#xE921;" Style="{StaticResource Caption}"
                            ToolTip="最小化到托盘" Click="Min_Click"/>
                    <Button x:Name="CloseBtn" Content="&#xE8BB;" Style="{StaticResource CaptionDanger}"
                            ToolTip="关闭（继续在托盘运行）" Click="Close_Click" Margin="2,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ================= 主体 ================= -->
            <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0">
                <StackPanel Margin="18,14,18,14">

                    <!-- 状态卡 -->
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="14" Padding="16,13,16,12">
                        <StackPanel>
                            <Grid Height="66">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="StateDot" Width="7" Height="7" CornerRadius="4"
                                                Background="{StaticResource Text3}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StateText" Text="未开始" FontSize="19"
                                                   FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                                   Margin="9,0,0,0" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="StateDetail"
                                               Text="选择监控对象，然后点击「开始监控」"
                                               FontSize="12" Foreground="{StaticResource Text2}"
                                               Margin="0,7,0,0" TextWrapping="Wrap" MaxHeight="36"
                                               TextTrimming="CharacterEllipsis" LineHeight="17"/>
                                </StackPanel>

                                <Grid Grid.Column="1" Width="68" Height="68">
                                    <ui:ProgressRing x:Name="Ring" Value="0" StrokeThickness="5"
                                                     TrackBrush="#1E222E" AccentBrush="{StaticResource Accent}"/>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="RingValue" Text="—"
                                                   FontFamily="{StaticResource Mono}" FontSize="17"
                                                   FontWeight="SemiBold" Foreground="{StaticResource Text2}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="RingCaption" Text="待机" FontSize="10"
                                                   Foreground="{StaticResource Text3}" Margin="0,1,0,0"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <Rectangle Height="1" Fill="{StaticResource LineSoft}" Margin="0,13,0,0"/>

                            <Grid Margin="0,11,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.85*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="0.8*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="速度" FontSize="10.5" Foreground="{StaticResource Text3}"/>
                                    <TextBlock x:Name="MetricSpeed" Text="—"
                                               FontFamily="{StaticResource Mono}" FontSize="13.5"
                                               FontWeight="SemiBold" Foreground="{StaticResource Text2}"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource LineSoft}"
                                           Margin="0,1,0,1"/>

                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="数据量" FontSize="10.5" Foreground="{StaticResource Text3}"/>
                                    <TextBlock x:Name="MetricVolume" Text="—"
                                               FontFamily="{StaticResource Mono}" FontSize="13.5"
                                               FontWeight="SemiBold" Foreground="{StaticResource Text2}"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Rectangle Grid.Column="3" Width="1" Fill="{StaticResource LineSoft}"
                                           Margin="0,1,0,1"/>

                                <StackPanel Grid.Column="4" Margin="12,0,0,0">
                                    <TextBlock Text="静默" FontSize="10.5" Foreground="{StaticResource Text3}"/>
                                    <TextBlock x:Name="MetricIdle" Text="—"
                                               FontFamily="{StaticResource Mono}" FontSize="13.5"
                                               FontWeight="SemiBold" Foreground="{StaticResource Text2}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="ReasonRow" Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="依据" FontSize="10.5" Foreground="{StaticResource Text3}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="ReasonText" Text="—" FontSize="11"
                                           Foreground="{StaticResource Text2}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           MaxWidth="390"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 监控对象 -->
                    <Grid Margin="2,14,2,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="监控对象" Style="{StaticResource SecLabel}"/>
                        <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource Line}"
                                   VerticalAlignment="Center" Margin="11,0,11,0"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TargetMeta" Text="" FontSize="11"
                                       Foreground="{StaticResource Text3}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                            <Button x:Name="RescanBtn" Content="刷新" Style="{StaticResource Link}"
                                    Margin="6,0,-7,0" Click="Rescan_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{StaticResource Inset}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="10" Padding="3">
                        <UniformGrid Columns="3" Rows="1">
                            <RadioButton x:Name="ModeProgram" Content="软件" GroupName="mode"
                                         Style="{StaticResource Seg}" IsChecked="True" Checked="Mode_Checked"/>
                            <RadioButton x:Name="ModeSteam" Content="Steam" GroupName="mode"
                                         Style="{StaticResource Seg}" Checked="Mode_Checked"/>
                            <RadioButton x:Name="ModeFolder" Content="文件夹" GroupName="mode"
                                         Style="{StaticResource Seg}" Checked="Mode_Checked"/>
                        </UniformGrid>
                    </Border>

                    <!-- 软件模式 -->
                    <StackPanel x:Name="ProgramPanel" Margin="0,9,0,0">
                        <Border Background="{StaticResource Inset}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="10" Padding="3">
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ProgramRows"/>
                            </ScrollViewer>
                        </Border>
                        <TextBlock x:Name="ProgHint" Text="进程退出、或磁盘读写静止超过「静默」时长即判定完成"
                                   FontSize="11" Foreground="{StaticResource Text3}"
                                   Margin="3,8,3,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Steam 模式 -->
                    <StackPanel x:Name="SteamPanel" Margin="0,9,0,0" Visibility="Collapsed">
                        <Border Background="{StaticResource Inset}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="10" Padding="3">
                            <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="SteamRows"/>
                            </ScrollViewer>
                        </Border>
                        <TextBlock x:Name="SteamHint" Text="列出 Steam 队列里未完成的任务"
                                   FontSize="11" Foreground="{StaticResource Text3}"
                                   Margin="3,8,3,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- 文件夹模式 -->
                    <StackPanel x:Name="FolderPanel" Margin="0,9,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PathBox" Style="{StaticResource Input}" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="浏览" Style="{StaticResource Ghost}" Width="64"
                                    Height="36" Margin="8,0,0,0" Click="Browse_Click"/>
                        </Grid>
                        <TextBlock x:Name="FolderHint" Text="浏览器下载用这个模式（浏览器常驻，软件模式判不准）"
                                   FontSize="11" Foreground="{StaticResource Text3}"
                                   Margin="3,8,3,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- 完成后执行 -->
                    <Grid Margin="2,14,2,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="完成后执行" Style="{StaticResource SecLabel}"/>
                        <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource Line}"
                                   VerticalAlignment="Center" Margin="11,0,0,0"/>
                    </Grid>

                    <Border Background="{StaticResource Inset}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="10" Padding="3">
                        <UniformGrid Columns="4" Rows="1">
                            <RadioButton x:Name="ActShutdown" Content="关机" GroupName="act"
                                         Style="{StaticResource Seg}" IsChecked="True" Checked="Act_Checked"/>
                            <RadioButton x:Name="ActSleep" Content="睡眠" GroupName="act"
                                         Style="{StaticResource Seg}" Checked="Act_Checked"/>
                            <RadioButton x:Name="ActHibernate" Content="休眠" GroupName="act"
                                         Style="{StaticResource Seg}" Checked="Act_Checked"/>
                            <RadioButton x:Name="ActNotify" Content="仅提醒" GroupName="act"
                                         Style="{StaticResource Seg}" Checked="Act_Checked"/>
                        </UniformGrid>
                    </Border>

                    <!-- 高级设置 -->
                    <ToggleButton x:Name="AdvToggle" Style="{StaticResource Disclosure}" Margin="0,12,0,0"
                                  Tag="" Checked="Adv_Toggled" Unchecked="Adv_Toggled"/>

                    <StackPanel x:Name="AdvPanel" Margin="0,10,0,0" Visibility="Collapsed">

                        <StackPanel x:Name="ThresholdPanel">
                            <Grid Margin="3,2,3,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="静默判定" FontSize="12" Foreground="{StaticResource Text2}"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="QuietBox" Grid.Column="1" Style="{StaticResource NumInput}"
                                         Text="300" LostFocus="QuietBox_LostFocus"
                                         PreviewKeyDown="NumBox_KeyDown"/>
                                <TextBlock Grid.Column="2" Text="秒" FontSize="11"
                                           Foreground="{StaticResource Text3}" VerticalAlignment="Center"
                                           Margin="6,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="无写入超过此时长 → 进入倒计时"
                                           FontSize="11" Foreground="{StaticResource Text3}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="3,9,3,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="关机宽限" FontSize="12" Foreground="{StaticResource Text2}"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="GraceBox" Grid.Column="1" Style="{StaticResource NumInput}"
                                         Text="60" LostFocus="GraceBox_LostFocus"
                                         PreviewKeyDown="NumBox_KeyDown"/>
                                <TextBlock Grid.Column="2" Text="秒" FontSize="11"
                                           Foreground="{StaticResource Text3}" VerticalAlignment="Center"
                                           Margin="6,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="倒计时期间可随时停止"
                                           FontSize="11" Foreground="{StaticResource Text3}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="SignalPanel" Margin="3,16,3,0">
                            <TextBlock Text="判定信号（任一成立即视为仍在下载）" FontSize="11"
                                       Foreground="{StaticResource Text3}" Margin="0,0,0,9"/>
                            <CheckBox x:Name="CkTemp" Content="临时文件后缀 .part / .crdownload"
                                      Style="{StaticResource Check}" IsChecked="True" Margin="0,0,0,9"/>
                            <CheckBox x:Name="CkHandle" Content="文件句柄独占试探（最通用）"
                                      Style="{StaticResource Check}" IsChecked="True" Margin="0,0,0,9"/>
                            <CheckBox x:Name="CkRecursive" Content="包含子目录"
                                      Style="{StaticResource Check}" Margin="0,0,0,9"/>
                            <CheckBox x:Name="CkProcIo" Content="下载进程磁盘写入（激进）"
                                      Style="{StaticResource Check}"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{StaticResource LineSoft}" Margin="3,15,3,13"/>

                        <CheckBox x:Name="CkDrill" Content="演练模式（只提醒，不真正执行）"
                                  Style="{StaticResource Switch}" IsChecked="True"
                                  Checked="Drill_Checked" Unchecked="Drill_Checked" Margin="3,0,0,0"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- ================= 底栏 ================= -->
            <Grid Grid.Row="2" Background="{StaticResource Surface}">
                <Rectangle Height="1" Fill="{StaticResource Line}" VerticalAlignment="Top"/>
                <StackPanel Margin="18,10,18,12">

                    <Grid Margin="2,0,2,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PlanText" Text="—" FontSize="11.5"
                                   Foreground="{StaticResource Text3}" TextWrapping="Wrap"
                                   LineHeight="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border x:Name="PlanBadge" Grid.Column="1" CornerRadius="5"
                                Background="#1A1E29" BorderBrush="#2C3142" BorderThickness="1"
                                Padding="7,3" VerticalAlignment="Center">
                            <TextBlock x:Name="PlanBadgeText" Text="演练" FontSize="10"
                                       Foreground="{StaticResource Text2}"/>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="92"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StartBtn" Content="开始监控" Style="{StaticResource Primary}"
                                Height="40" Click="Start_Click"/>
                        <Button x:Name="StopBtn" Grid.Column="2" Content="停止" Style="{StaticResource Ghost}"
                                Height="40" IsEnabled="False" Click="Stop_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
