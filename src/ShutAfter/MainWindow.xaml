<Window x:Class="ShutAfter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShutAfter" Width="486" SizeToContent="Height" MinHeight="520"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#13131A" Foreground="#E6E6EE"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6F6F80"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Width="6" HorizontalAlignment="Center">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#3C3C4C"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"
                                                  Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"
                                                  Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="#1B1B23"/>
            <Setter Property="Foreground" Value="#E6E6EE"/>
            <Setter Property="BorderBrush" Value="#2C2C38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#4C8DFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4C8DFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="#C9C9D6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="#20202A"
                                BorderBrush="#2E2E3A" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2A36"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3C3C4C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" Background="#3B78E7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4C8DFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9394A6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="8" Background="#1B1B23"
                                BorderBrush="#2C2C38" BorderThickness="1" Padding="14,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#414154"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#17294A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4C8DFF"/>
                                <Setter Property="Foreground" Value="#CFE0FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Sw" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C0C0CE"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,0,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="bd" Width="17" Height="17" CornerRadius="5" Background="#1B1B23"
                                    BorderBrush="#343442" BorderThickness="1" VerticalAlignment="Center">
                                <Path x:Name="tick" Data="M 3,8 L 6.4,11.4 L 13,4.6" Stroke="#FFFFFF"
                                      StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3B78E7"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4C8DFF"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#A8A8B8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="6" Background="Transparent" Padding="9,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E1E28"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#17294A"/>
                                <Setter Property="Foreground" Value="#CFE0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#8A8A9C"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="Transparent" Width="30" Height="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26262F"/>
                                <Setter Property="Foreground" Value="#E6E6EE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border BorderBrush="#26262F" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="66"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#17171F" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="8" Height="8" CornerRadius="4" Background="#4C8DFF" VerticalAlignment="Center"/>
                    <TextBlock Text="ShutAfter" FontSize="13.5" FontWeight="Medium" Margin="9,0,0,0"
                               Foreground="#E6E6EE" VerticalAlignment="Center"/>
                    <TextBlock Text="下载完成关机" FontSize="11.5" Foreground="#5E5E70"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HeaderHint" Text="· 未运行" FontSize="11.5" Foreground="#4A4A5A"
                               Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <Button x:Name="MinBtn" Content="—" Style="{StaticResource IconBtn}" Click="Min_Click"/>
                    <Button x:Name="CloseBtn" Content="✕" Style="{StaticResource IconBtn}" Click="Close_Click"
                            FontSize="12"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="18,16,18,0">

                <!-- 状态卡 -->
                <Border CornerRadius="12" Background="#191921" BorderBrush="#272733" BorderThickness="1"
                        Padding="16,14,16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="StateDot" Width="9" Height="9" CornerRadius="5" Background="#8A8A99"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="StateText" Text="未开始" FontSize="16.5" FontWeight="Medium"
                                       Margin="9,0,0,0" Foreground="#E6E6EE" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StateSize" Text="" FontSize="11.5" Foreground="#5E5E70"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="StateDetail" Text="选择监控对象后点击开始监控" FontSize="12"
                                   Foreground="#7A7A8C" Margin="0,7,0,0" TextWrapping="Wrap"/>

                        <Grid x:Name="ProgressTrack" Height="5" Margin="0,13,0,0" ClipToBounds="True">
                            <Border CornerRadius="3" Background="#242430"/>
                            <Border x:Name="ProgressFill" CornerRadius="3" Background="#4C8DFF"
                                    HorizontalAlignment="Left" Width="0"/>
                        </Grid>

                        <TextBlock x:Name="ReasonText" Text="判定依据：—" FontSize="11.5" Foreground="#5A5A6C"
                                   Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- 监控对象 -->
                <TextBlock Text="监控对象" Style="{StaticResource Lbl}" Margin="2,18,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ModeProgram" Content="软件" GroupName="mode"
                                 Style="{StaticResource Chip}" IsChecked="True" Checked="Mode_Checked"/>
                    <RadioButton x:Name="ModeSteam" Content="Steam" GroupName="mode"
                                 Style="{StaticResource Chip}" Checked="Mode_Checked"/>
                    <RadioButton x:Name="ModeFolder" Content="文件夹" GroupName="mode"
                                 Style="{StaticResource Chip}" Checked="Mode_Checked"/>
                </StackPanel>

                <!-- 软件模式 -->
                <StackPanel x:Name="ProgramPanel" Margin="0,12,0,0">
                    <Grid>
                        <TextBlock x:Name="ProgramHint" Text="选择正在运行的下载软件" FontSize="12"
                                   Foreground="#8E8EA0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,90,0"/>
                        <Button x:Name="RescanProgBtn" Content="刷新列表" Style="{StaticResource Ghost}"
                                Width="84" Height="30" HorizontalAlignment="Right" FontSize="12"
                                Click="RescanPrograms_Click"/>
                    </Grid>
                    <Border Background="#14141C" BorderBrush="#2C2C38" BorderThickness="1" CornerRadius="8"
                            Margin="0,10,0,0" Padding="4,4,2,4">
                        <ListBox x:Name="ProgramList" Background="Transparent" BorderThickness="0"
                                 Foreground="#C0C0CE" MaxHeight="150"
                                 ItemContainerStyle="{StaticResource ListItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Border>
                    <TextBlock Text="进程退出，或磁盘读写连续静止超过「静默」时长 → 判定完成。适合迅雷、IDM、网盘客户端。"
                               FontSize="11" Foreground="#5A5A6C" Margin="2,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Steam 模式 -->
                <StackPanel x:Name="SteamPanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid>
                        <TextBlock x:Name="SteamLibText" Text="正在检测 Steam 库…" FontSize="12"
                                   Foreground="#8E8EA0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,90,0"/>
                        <Button x:Name="RescanSteamBtn" Content="重新扫描" Style="{StaticResource Ghost}"
                                Width="84" Height="30" HorizontalAlignment="Right" FontSize="12"
                                Click="RescanSteam_Click"/>
                    </Grid>
                    <Border Background="#14141C" BorderBrush="#2C2C38" BorderThickness="1" CornerRadius="8"
                            Margin="0,10,0,0" Padding="4,4,2,4">
                        <ListBox x:Name="SteamList" Background="Transparent" BorderThickness="0"
                                 Foreground="#C0C0CE" MaxHeight="150"
                                 ItemContainerStyle="{StaticResource ListItem}"
                                 SelectionChanged="SteamList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Border>
                    <TextBlock Text="列出 Steam 正在下载的任务；运行中可直接点选切换监控目标。"
                               FontSize="11" Foreground="#5A5A6C" Margin="2,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 文件夹模式 -->
                <StackPanel x:Name="FolderPanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" Style="{StaticResource Input}" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="浏览" Style="{StaticResource Ghost}" Width="66"
                                Height="38" Margin="8,0,0,0" Click="Browse_Click"/>
                    </Grid>
                    <TextBlock Text="监视目录内是否还有人在写文件。浏览器下载请用这个模式（浏览器常驻，软件模式判不准）。"
                               FontSize="11" Foreground="#5A5A6C" Margin="2,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 判定阈值 -->
                <TextBlock Text="判定阈值" Style="{StaticResource Lbl}" Margin="2,18,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBlock Text="静默判定（秒）" FontSize="12" Foreground="#8E8EA0" VerticalAlignment="Center"/>
                        <TextBox x:Name="QuietBox" Style="{StaticResource Input}" Width="72"
                                 HorizontalAlignment="Right" TextAlignment="Center"
                                 Text="90" LostFocus="QuietBox_LostFocus"/>
                    </Grid>

                    <Grid Grid.Column="2">
                        <TextBlock Text="关机宽限（秒）" FontSize="12" Foreground="#8E8EA0" VerticalAlignment="Center"/>
                        <TextBox x:Name="GraceBox" Style="{StaticResource Input}" Width="72"
                                 HorizontalAlignment="Right" TextAlignment="Center"
                                 Text="60" LostFocus="GraceBox_LostFocus"/>
                    </Grid>
                </Grid>
                <TextBlock Text="持续无下载流量超过「静默」时长 → 进入倒计时；倒计时内流量恢复会自动取消。"
                           FontSize="11" Foreground="#5A5A6C" Margin="2,8,0,0" TextWrapping="Wrap"/>

                <!-- 完成动作 -->
                <TextBlock Text="完成后执行" Style="{StaticResource Lbl}" Margin="2,18,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ActShutdown" Content="关机" GroupName="act" Style="{StaticResource Chip}"
                                 IsChecked="True"/>
                    <RadioButton x:Name="ActSleep" Content="睡眠" GroupName="act" Style="{StaticResource Chip}"/>
                    <RadioButton x:Name="ActHibernate" Content="休眠" GroupName="act" Style="{StaticResource Chip}"/>
                    <RadioButton x:Name="ActNotify" Content="仅提醒" GroupName="act" Style="{StaticResource Chip}"/>
                </StackPanel>

                <!-- 高级 -->
                <StackPanel x:Name="SignalPanel">
                    <TextBlock Text="判定信号" Style="{StaticResource Lbl}" Margin="2,20,0,8"/>
                    <CheckBox x:Name="CkTemp" Content="监视下载器临时文件（.crdownload / .part / .td …）"
                              Style="{StaticResource Sw}" IsChecked="True"/>
                    <CheckBox x:Name="CkHandle" Content="文件句柄独占试探（最通用的完成信号）"
                              Style="{StaticResource Sw}" IsChecked="True"/>
                    <CheckBox x:Name="CkRecursive" Content="包含子目录" Style="{StaticResource Sw}"/>
                    <CheckBox x:Name="CkProcIo" Content="下载进程磁盘写入（激进，仅建议排除浏览器）"
                              Style="{StaticResource Sw}"/>
                </StackPanel>
                <CheckBox x:Name="CkDrill" Content="演练模式：只提醒，不真正关机"
                          Style="{StaticResource Sw}" IsChecked="True" Margin="0,14,0,14"/>

            </StackPanel>

            <!-- 底部按钮 -->
            <Grid Grid.Row="2" Background="#15151C">
                <Border VerticalAlignment="Top" Height="1" Background="#242430"/>
                <Grid Margin="18,13,18,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="StartBtn" Content="开始监控" Style="{StaticResource Primary}" Click="Start_Click"/>
                    <Button x:Name="StopBtn" Grid.Column="2" Content="停止" Style="{StaticResource Ghost}"
                            Width="84" IsEnabled="False" Click="Stop_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
